{
  "name": "rulecard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rulecard: a memecoin launchpad where every coin plays rule cards. Built at NEAR HACKATHON.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sandbox:start": "bash sandbox/start.sh",
    "sandbox:deploy": "node sandbox/deploy.mjs",
    "sandbox:bots": "node sandbox/bots.mjs",
    "sandbox:reset": "bash sandbox/reset.sh",
    "sandbox:seed": "node sandbox/seed.mjs"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "near-api-js": "5.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
