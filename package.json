{
  "name": "rulecard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rulecard: a memecoin launchpad where every coin plays rule cards. Built at NEAR HACKATHON.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bash contracts/dcargo.sh coin test && bash contracts/dcargo.sh coin \"test --features demo\" && bash contracts/dcargo.sh factory test && bash contracts/dcargo.sh factory \"test --features demo\"",
    "typecheck": "tsc --noEmit",
    "sandbox:start": "bash sandbox/start.sh",
    "sandbox:deploy": "node sandbox/deploy.mjs",
    "sandbox:reset": "bash sandbox/reset.sh",
    "sandbox:seed": "node sandbox/seed.mjs",
    "contracts:build": "bash contracts/build.sh"
  },
  "dependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "@near-wallet-selector/modal-ui": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "buffer": "6.0.3",
    "near-api-js": "5.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
