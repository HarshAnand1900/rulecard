{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rulecard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "rulecard-testnet",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "testnet",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "rulecard-practice",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "practice",
        "--port",
        "5175"
      ],
      "port": 5175
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--directory",
        "site"
      ],
      "port": 5180
    },
    {
      "name": "dist",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5182",
        "--directory",
        "dist"
      ],
      "port": 5182
    }
  ]
}